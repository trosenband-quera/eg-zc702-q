CWD=`pwd`

mkdir -p ../thirdparty
cd ../thirdparty

NAME=msgpack-c
VERSION=6.1.0
DEST=`pwd`/usr/local

set -e

if [ ! -d "$NAME" ]; then
  git clone https://github.com/msgpack/msgpack-c.git
fi

cd $NAME

git tag -l

git checkout c-$VERSION

#exit

mkdir -p build
cd build

cmake --install-prefix $DEST -DCMAKE_TOOLCHAIN_FILE=$CWD/toolchain-zc702.cmake ..

make clean

make -j 8

make install
